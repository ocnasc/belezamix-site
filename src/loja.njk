---
layout: base.njk
pagination:
  data: site.lojas
  size: 1
  alias: loja
  addAllPagesToCollections: true
permalink: "{{ loja.url }}"
eleventyComputed:
  titulo: "Cosméticos em {{ loja.bairro }}, Jundiaí | Belezamix"
  h1: "{{ loja.nome }}"
  descricao: "{{ loja.nome }}: {{ loja.enderecoCompleto }}. Chame no WhatsApp ou veja como chegar."
  jsonld: "{{ loja.jsonld | safe }}"
---
<div class="pagina">
  <section class="loja loja--detalhe" aria-label="Endereço e contato">
    {% if loja.fachada %}
    <img class="foto foto--fachada" src="{{ loja.fachada.src }}" alt="{{ loja.fachada.alt }}" loading="eager">
    {% else %}
    <p class="pendente">{{ loja.fachadaPendente }}</p>
    {% endif %}
    <p class="loja__endereco">{{ loja.enderecoCompleto }}</p>
    <ul class="loja__horarios">{% for h in loja.horarios %}<li>{{ h }}</li>{% endfor %}</ul>
    <p class="loja__telefone">{{ loja.telefoneExibido }}</p>
    {% if loja.whatsappHref %}
    <a class="btn-whats" href="{{ loja.whatsappHref }}" aria-label="Chamar no WhatsApp da loja {{ loja.nomeCurto }}"><span class="icone icone--whats" aria-hidden="true"></span>Chamar no WhatsApp</a>
    {% else %}
    <span class="btn-whats btn-whats--pendente"><span class="icone icone--whats" aria-hidden="true"></span>Chamar no WhatsApp</span>
    <p class="pendente">{{ loja.whatsappPendente }}</p>
    {% endif %}
    <a class="link-mapa" href="{{ loja.mapaHref }}"><span class="icone icone--pin" aria-hidden="true"></span>Como chegar</a>
  </section>
  {% if loja.fotos.length %}
  <section class="galeria" aria-label="Fotos da loja">
    {% for f in loja.fotos %}<img class="foto" src="{{ f.src }}" alt="{{ f.alt }}" loading="lazy">{% endfor %}
  </section>
  {% endif %}
</div>
